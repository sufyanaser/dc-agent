{
  "relayUrl": "wss://dc-custom-relay.YOUR-SUBDOMAIN.workers.dev/device",
  "deviceToken": "SET_BY_INSTALL_OR_ENV_DC_DEVICE_TOKEN",
  "deviceId": "MY-PC",
  "policy": {
    "profile": "scoped",
    "allowedRoots": ["C:\\Users\\YOU\\Projects"],
    "denyPatterns": [],
